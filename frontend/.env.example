# Copie para frontend/.env e preencha. Variáveis VITE_* vão para o bundle: nada secreto aqui.

# Só para o `npm run dev`: para onde o Vite repassa as chamadas a /api (DEC-023).
# Não tem prefixo VITE_, então não vai para o bundle. Em produção quem repassa é o vercel.json.
API_PROXY_TARGET=http://localhost:3333

# Mesma chave pública VAPID do backend
VITE_VAPID_PUBLIC_KEY=CHANGE_ME
