{
  "env": {
    "FAISCA_TEST_DB": "faisca_test_claude",
    "E2E_API_PORT": "3334",
    "E2E_WEB_PORT": "5174"
  },
  "permissions": {
    "deny": ["Read(**/.env)"],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "PowerShell(git push *)",
      "PowerShell(gh pr create *)",
      "PowerShell(gh pr merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Glob|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
