# Copie para backend/.env e preencha. Nunca commite o .env.

# Servidor
PORT=3333
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Proxies na frente da API. Dev: 0. Produção: Vercel + borda do Railway (confirmar com LOG_LEVEL=debug, docs/DEPLOY.md).
TRUST_PROXY_HOPS=0
# Commit no ar, devolvido pelo /health (DEC-056). Preenchido sozinho pelo Railway: deixe sem definir em dev.
# RAILWAY_GIT_COMMIT_SHA=

# Postgres local (npm run db:up). Só para dev; no Railway os usuários são criados à mão.
# As senhas do faisca_migrator e do faisca_app precisam ser as mesmas das URLs abaixo.
# Se a 5432 já estiver em uso por outro Postgres, use 5433 aqui e nas URLs abaixo.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=CHANGE_ME
FAISCA_MIGRATOR_PASSWORD=CHANGE_ME
FAISCA_APP_PASSWORD=CHANGE_ME

# Banco (instância Postgres própria do Faísca)
# Runtime da API: usuário faisca_app, apenas DML (SELECT/INSERT/UPDATE/DELETE)
DATABASE_URL=postgresql://faisca_app:CHANGE_ME@localhost:5432/faisca
# Migrações (prisma migrate): usuário faisca_migrator, com DDL
MIGRATION_DATABASE_URL=postgresql://faisca_migrator:CHANGE_ME@localhost:5432/faisca

# Auth (mínimo de 32 caracteres)
JWT_SECRET=CHANGE_ME_gere_com_openssl_rand_base64_48
# Chave do HMAC dos códigos de vínculo (mínimo de 32 caracteres, diferente do JWT_SECRET)
LINK_CODE_SECRET=CHANGE_ME_gere_com_openssl_rand_base64_48

# E-mail (Resend). Crie uma chave em resend.com > API Keys (permissão Sending access).
RESEND_API_KEY=CHANGE_ME
ANNOUNCEMENT_EMAIL_RELEASES=
# Dev: remetente de teste do Resend, que só entrega para o e-mail dono da conta do Resend.
# Produção: Faísca <nao-responda@minhafaisca.com.br> (domínio verificado no Resend, docs/DEPLOY.md).
EMAIL_FROM="Faísca <onboarding@resend.dev>"
# Alertas de segurança (DEC-141): e-mail de quem cuida do Faísca. Vazio = só no log.
SECURITY_ALERT_EMAIL=

# Web Push (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:contato@seu-dominio.com

# Verificação em duas etapas (DEC-092): cifra o segredo do app autenticador e faz o HMAC dos
# códigos. Opcional: sem ela, o 2FA fica indisponível. Gere com: openssl rand -base64 48
TWO_FACTOR_SECRET=CHANGE_ME_gere_com_openssl_rand_base64_48

# Issue #220 / DEC-113: e-mails de contas que podem moderar apenas o conteúdo da comunidade.
# Separe mais de um com vírgula. Todas as contas moderadoras precisam ativar o 2FA.
COMMUNITY_MODERATOR_EMAILS=

# Verificação do armazenamento privado de mídia (#143). Use um bucket de teste próprio.
ACTION_VIDEOS_ENABLED=false
ACTIVITY_VIDEOS_ENABLED=false
PRIVATE_FILES_R2_ENDPOINT=CHANGE_ME
PRIVATE_FILES_R2_BUCKET=CHANGE_ME
PRIVATE_FILES_R2_ACCESS_KEY_ID=CHANGE_ME
PRIVATE_FILES_R2_SECRET_ACCESS_KEY=CHANGE_ME

# Cópia de vídeos (somente no ambiente do operador, carregado antes de npm run media:backup)
VIDEO_BACKUP_R2_ENDPOINT=CHANGE_ME
VIDEO_BACKUP_R2_BUCKET=CHANGE_ME
VIDEO_BACKUP_R2_ACCESS_KEY_ID=CHANGE_ME
VIDEO_BACKUP_R2_SECRET_ACCESS_KEY=CHANGE_ME
VIDEO_BACKUP_DATABASE_URL=CHANGE_ME
VIDEO_BACKUP_AGE_RECIPIENT=CHANGE_ME
# Somente durante a restauração:
VIDEO_RESTORE_AGE_IDENTITY_FILE=CHANGE_ME
VIDEO_RESTORE_SOURCE_DATABASE_URL=CHANGE_ME
