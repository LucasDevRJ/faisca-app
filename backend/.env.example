# Copie para backend/.env e preencha. Nunca commite o .env.

# Servidor
PORT=3333
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Banco (instância Postgres própria do Faísca)
# Runtime da API: usuário faisca_app, apenas DML (SELECT/INSERT/UPDATE/DELETE)
DATABASE_URL=postgresql://faisca_app:CHANGE_ME@localhost:5432/faisca
# Migrações (prisma migrate): usuário faisca_migrator, com DDL
MIGRATION_DATABASE_URL=postgresql://faisca_migrator:CHANGE_ME@localhost:5432/faisca

# Auth
JWT_SECRET=CHANGE_ME_gere_com_openssl_rand_base64_48

# E-mail (Resend)
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM="Faísca <nao-responda@seu-dominio.com>"

# Web Push (gere com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:contato@seu-dominio.com