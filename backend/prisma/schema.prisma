// Schema do Faísca. Os models entram por etapa (usuários, atividades, consultas, vínculos).
// A URL do banco fica no prisma.config.ts (CLI) e em src/lib/prisma.ts (runtime).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  // Sempre em minúsculas e sem espaços nas pontas (normalizado no schema Zod).
  email               String    @unique
  passwordHash        String
  // Pelo menos um dos dois é true: garantido por CHECK na migration (DEC-013).
  hasPatientProfile   Boolean   @default(false)
  hasTherapistProfile Boolean   @default(false)
  // null = e-mail ainda não confirmado; o login é recusado até confirmar.
  emailConfirmedAt    DateTime?
  // Vai dentro do JWT. Ao redefinir a senha, sobe e derruba as sessões abertas (DEC-025).
  sessionVersion      Int       @default(0)
  // Consentimento com o aviso de privacidade (LGPD, dado de saúde; DEC-036): quando e qual versão.
  // null só em contas criadas antes do aviso existir.
  privacyAcceptedAt   DateTime?
  privacyVersion      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  authTokens      AuthToken[]
  activities      Activity[]
  appointments    Appointment[]
  schedules       AppointmentSchedule[]
  therapyPauses   TherapyPause[]
  actions         BehavioralAction[]
  thoughtRecords  ThoughtRecord[]
  tensionEpisodes TensionEpisode[]

  // Vínculo (DEC-015, DEC-031): o mesmo usuário pode estar dos dois lados, em vínculos diferentes.
  linksAsPatient   TherapistLink[]   @relation("LinkPatient")
  linksAsTherapist TherapistLink[]   @relation("LinkTherapist")
  invitesSent      LinkInvite[]      @relation("InvitePatient")
  invitesSignedUp  LinkInvite[]      @relation("InviteSignupUser")
  linkCodes        LinkCode[]
  linkCodeAttempts LinkCodeAttempt[]
}

enum AuthTokenType {
  EMAIL_CONFIRMATION
  PASSWORD_RESET
}

// Links enviados por e-mail. O token em texto só existe no e-mail; aqui fica o hash (SHA-256).
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Estados da SPEC. CONCLUIDA e NAO_REALIZADA são finais (DEC-012).
enum ActivityStatus {
  PLANEJADA
  PENDENTE
  CONCLUIDA
  NAO_REALIZADA
}

// Registro de atividade do paciente. Os campos exigidos por estado e a faixa das notas
// (inteiros de 0 a 10) são garantidos por CHECK na migration, além do Zod (DEC-028).
model Activity {
  id           String         @id @default(uuid()) @db.Uuid
  // O paciente dono do registro.
  userId       String         @db.Uuid
  name         String
  // Dia da atividade, no fuso America/Sao_Paulo (DEC-007). Separado do createdAt.
  activityDate DateTime       @db.Date
  status       ActivityStatus
  // Vontade antes (0–10): exigida a partir de PENDENTE.
  wantBefore   Int?
  // Prazer e realização (0–10): só na CONCLUIDA.
  pleasure     Int?
  achievement  Int?
  // Só nos estados finais, e sempre opcional.
  observation  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activityDate])
}

// Datas das consultas, registradas pelo paciente (DEC-017). Servem para "última" e "próxima"
// consulta e, na etapa de vínculo, para o filtro e o destaque da terapeuta.
// Consulta avulsa (DEC-030): uma sessão fora da recorrência, ou as de antes da agenda (DEC-045).
model Appointment {
  id              String    @id @default(uuid()) @db.Uuid
  // O paciente dono do registro.
  userId          String    @db.Uuid
  // Só o dia, no fuso America/Sao_Paulo (DEC-007).
  appointmentDate DateTime  @db.Date
  // Hora no relógio de São Paulo, sem segundos (DEC-045). Obrigatória nas novas; vazia nas
  // consultas registradas antes da agenda, que só tinham o dia.
  appointmentTime DateTime? @db.Time(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Uma consulta avulsa por dia (DEC-030); o choque com a recorrência é conferido no service.
  @@unique([userId, appointmentDate])
}

enum AppointmentFrequency {
  SEMANAL
  QUINZENAL
}

// Por que uma regra terminou: o paciente mudou dia, hora ou frequência, ou encerrou a terapia.
enum ScheduleEndReason {
  MUDANCA
  ENCERRAMENTO
}

// Regra da agenda (DEC-045): a primeira sessão, a hora e a frequência. As sessões são
// calculadas a partir dela, sem uma linha por sessão. Regras antigas ficam como histórico.
model AppointmentSchedule {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  // Primeira sessão: o dia da semana da recorrência sai dela.
  startDate DateTime             @db.Date
  // Hora no relógio de São Paulo, sem segundos.
  time      DateTime             @db.Time(0)
  frequency AppointmentFrequency
  // Último dia em que a regra vale (inclusive). null = a regra em vigor. Pode ficar antes do
  // startDate quando a regra termina sem nenhuma sessão.
  endDate   DateTime?            @db.Date
  endReason ScheduleEndReason?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  exceptions AppointmentException[]

  // Uma regra em vigor por paciente: índice único parcial na migration (WHERE "endDate" IS NULL).
  @@index([userId])
}

enum AppointmentExceptionType {
  DESMARCADA
  REMARCADA
}

// O que mudou numa sessão específica da recorrência, sempre com o motivo (DEC-045).
model AppointmentException {
  id           String                   @id @default(uuid()) @db.Uuid
  scheduleId   String                   @db.Uuid
  // O dia em que a sessão cairia pela regra.
  originalDate DateTime                 @db.Date
  type         AppointmentExceptionType
  // Só na remarcada: o novo dia e a nova hora.
  newDate      DateTime?                @db.Date
  newTime      DateTime?                @db.Time(0)
  reason       String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  schedule AppointmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, originalDate])
}

// Pausa na terapia (DEC-045): sem sessões de startDate até a véspera do returnDate.
// Sem returnDate, a pausa vale até o paciente retomar.
model TherapyPause {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  startDate  DateTime  @db.Date
  returnDate DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Emoções do Registro de Pensamentos (SPEC, "Registro de Pensamentos"; DEC-039).
// OUTRA vem com o nome escrito pelo paciente (otherLabel).
enum Emotion {
  TRISTEZA
  ANSIEDADE
  MEDO
  RAIVA
  CULPA
  VERGONHA
  FRUSTRACAO
  SOLIDAO
  ALEGRIA
  ALIVIO
  OUTRA
}

// Registro de Pensamentos (RPD) do paciente. Todos os campos são obrigatórios; tamanhos e a
// faixa da crença (0–10) são garantidos por CHECK na migration, além do Zod (DEC-039).
// Editar e excluir só no dia (São Paulo) em que foi registrado, conferido pelo createdAt.
model ThoughtRecord {
  id               String   @id @default(uuid()) @db.Uuid
  // O paciente dono do registro.
  userId           String   @db.Uuid
  // Dia da situação, no fuso America/Sao_Paulo (DEC-007). Só até hoje; separado do createdAt.
  situationDate    DateTime @db.Date
  situation        String
  automaticThought String
  // O quanto acredita no pensamento (0–10).
  beliefLevel      Int
  behavior         String
  consequence      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  emotions ThoughtRecordEmotion[]

  @@index([userId, situationDate])
}

// Emoções de um registro: uma ou mais, sem repetir, cada uma com intensidade de 0 a 10.
model ThoughtRecordEmotion {
  id         String  @id @default(uuid()) @db.Uuid
  recordId   String  @db.Uuid
  emotion    Emotion
  intensity  Int
  // Só na OUTRA, e obrigatório nela (CHECK na migration).
  otherLabel String?

  record ThoughtRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, emotion])
}

// Episódio de tensão do paciente (SPEC, "Episódios de tensão"; DEC-042). Tudo obrigatório, menos a
// hora. Tamanhos e a faixa das notas (0–10) são garantidos por CHECK na migration, além do Zod.
// Editar e excluir só no dia (São Paulo) em que foi registrado, conferido pelo createdAt.
model TensionEpisode {
  id           String    @id @default(uuid()) @db.Uuid
  // O paciente dono do registro.
  userId       String    @db.Uuid
  // Dia do episódio, no fuso America/Sao_Paulo (DEC-007). Só até hoje; separado do createdAt.
  episodeDate  DateTime  @db.Date
  // Hora do episódio no relógio de São Paulo, sem segundos. Opcional: a pessoa pode não lembrar.
  episodeTime  DateTime? @db.Time(0)
  situation    String
  // Tensão e vontade de vocalizar (tique vocal ou de ansiedade: falar, gritar, se mexer), 0–10.
  tensionLevel Int
  vocalizeUrge Int
  // O que a pessoa fez e o que aconteceu depois.
  behavior     String
  consequence  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, episodeDate])
}

enum LinkMethod {
  INVITE
  CODE
}

// Vínculo paciente ↔ terapeuta (SPEC, "Vínculo"). Revogar preenche revokedAt e o registro fica.
// Escritos à mão na migration: no máximo um vínculo ativo por paciente (índice único parcial)
// e ninguém se vincula a si mesmo (CHECK).
model TherapistLink {
  id              String     @id @default(uuid()) @db.Uuid
  patientId       String     @db.Uuid
  therapistId     String     @db.Uuid
  method          LinkMethod
  createdAt       DateTime   @default(now())
  revokedAt       DateTime?
  // null = o paciente ainda não viu o aviso de novo vínculo no app.
  seenByPatientAt DateTime?

  patient   User @relation("LinkPatient", fields: [patientId], references: [id], onDelete: Cascade)
  therapist User @relation("LinkTherapist", fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([therapistId])
}

// Convite por e-mail. Não expira e vale uma vez; o token em texto só existe no e-mail (regra 8).
// Escrito à mão na migration: no máximo um convite pendente por paciente.
model LinkInvite {
  id             String    @id @default(uuid()) @db.Uuid
  patientId      String    @db.Uuid
  // Para onde o convite foi enviado. Quem aceita pode usar outra conta (DEC-031).
  therapistEmail String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  acceptedAt     DateTime?
  canceledAt     DateTime?
  // Conta criada pelo link do convite: o vínculo nasce quando ela confirmar o e-mail.
  signupUserId   String?   @db.Uuid

  patient    User  @relation("InvitePatient", fields: [patientId], references: [id], onDelete: Cascade)
  signupUser User? @relation("InviteSignupUser", fields: [signupUserId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([signupUserId])
}

// Código de vínculo: 24 h, uma vez, invalidado ao gerar outro. Guardado como HMAC (DEC-031).
model LinkCode {
  id        String    @id @default(uuid()) @db.Uuid
  patientId String    @db.Uuid
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// Tentativas erradas de código, por terapeuta: 5 em 15 minutos bloqueiam (SPEC). Fica no banco,
// e não em memória, para o bloqueio sobreviver a um deploy.
model LinkCodeAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  therapistId String   @db.Uuid
  createdAt   DateTime @default(now())

  therapist User @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId, createdAt])
}

enum ActionCategory {
  PRAZER
  CONEXAO
  REALIZACAO
}

enum ActionStatus {
  PLANEJADA
  AVALIADA
  NAO_REALIZADA
}

// Ação (DEC-051): uma ação de prazer, de conexão ou de realização, planejada com a expectativa e
// avaliada depois com o prazer e a realização. Avaliada e não realizada são finais.
model BehavioralAction {
  id          String         @id @default(uuid()) @db.Uuid
  // O paciente dono do registro.
  userId      String         @db.Uuid
  // Dia da ação, no fuso America/Sao_Paulo (DEC-007); separado do createdAt.
  actionDate  DateTime       @db.Date
  name        String
  category    ActionCategory
  status      ActionStatus   @default(PLANEJADA)
  // Expectativa antes (0–10), sempre; prazer e realização depois (0–10), só na avaliada.
  expectation Int
  pleasure    Int?
  achievement Int?
  // Opcional na avaliada e na não realizada.
  observation String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, actionDate])
}
