// Schema do Faísca. Os models entram por etapa (usuários, atividades, consultas, vínculos).
// A URL do banco fica no prisma.config.ts (CLI) e em src/lib/prisma.ts (runtime).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AnnouncementEmailStatus {
  PENDING
  SENDING
  SENT
  SKIPPED
  FAILED
}

model User {
  messageEmailEnabled         Boolean           @default(true)
  messagePushEnabled          Boolean           @default(true)
  // Profissional (DEC-128): aceita mensagens "Sobre um registro". Começa ligado.
  messageRecordTopicsEnabled  Boolean           @default(true)
  tasks                       HomeworkTask[]
  dailyCheckIns               DailyCheckIn[]
  medications                 Medication[]
  symptoms                    Symptom[]
  id                          String            @id @default(uuid()) @db.Uuid
  name                        String
  // Sempre em minúsculas e sem espaços nas pontas (normalizado no schema Zod).
  email                       String            @unique
  passwordHash                String
  // Pelo menos um dos dois é true: garantido por CHECK na migration (DEC-013).
  hasPatientProfile           Boolean           @default(false)
  hasTherapistProfile         Boolean           @default(false)
  // Tipo de profissional (DEC-097): obrigatório com o perfil de terapeuta (CHECK na migration).
  // Quem já era terapeuta virou psicóloga. Muda só sem vínculo ativo.
  professionalKind            ProfessionalKind?
  // CRP ou CRM, opcional, só para mostrar ao paciente (1 a 30 caracteres, CHECK na migration).
  councilNumber               String?
  // null = e-mail ainda não confirmado; o login é recusado até confirmar.
  emailConfirmedAt            DateTime?
  // Vai dentro do JWT. Ao redefinir a senha, sobe e derruba as sessões abertas (DEC-025).
  sessionVersion              Int               @default(0)
  // Consentimento com o aviso de privacidade (LGPD, dado de saúde; DEC-036): quando e qual versão.
  // null só em contas criadas antes do aviso existir.
  privacyAcceptedAt           DateTime?
  privacyVersion              String?
  // A última novidade do app que a pessoa já viu (card de Novidades, DEC-054). Fica no banco, e
  // não no aparelho: no iPhone, o Safari e o app instalado não dividem o armazenamento.
  seenAnnouncement            String?
  // Perfil básico (DEC-061): o nome completo, opcional. O `name` é o "Como podemos te chamar?",
  // que continua sendo o nome mostrado no app.
  fullName                    String?
  // Paleta de cores escolhida (DEC-063); null = Sálvia, a padrão. Combina com o tema claro/escuro,
  // que continua no aparelho.
  palette                     Palette?
  // Ajustes de acessibilidade (DEC-076, issue #87): abertos a todos, desligados por padrão. Ficam
  // na conta para valer em qualquer aparelho.
  directLanguage              Boolean           @default(false)
  oneThingAtATime             Boolean           @default(false)
  comfortableReading          Boolean           @default(false)
  noTimePressure              Boolean           @default(false)
  reducedMotion               Boolean           @default(false)
  // Sono, humor e remédio (DEC-107): a pergunta "Tomou o remédio como combinado?" só aparece para
  // quem liga esta opção em Conta. Desligada por padrão.
  tracksMedication            Boolean           @default(false)
  // Remédios e o que sinto (DEC-114, #171): a seção só aparece para quem liga "Anotar meus remédios e
  // o que sinto" em Conta. Desligada por padrão; desligar só esconde, o que já foi anotado fica.
  listsMedications            Boolean           @default(false)
  // Aviso de login novo por e-mail e push (DEC-091, issue #135): ligado por padrão.
  loginAlertEnabled           Boolean           @default(true)
  // Avisos de novidades importantes por e-mail (DEC-119), separados dos avisos de conta.
  announcementEmailsEnabled   Boolean           @default(true)
  announcementEmailsEnabledAt DateTime?         @default(now())
  // Já entrou alguma vez? O primeiro login de todos não gera aviso de acesso novo (DEC-091).
  hasLoggedIn                 Boolean           @default(false)
  // Verificação em duas etapas (DEC-092). Código por e-mail ligado?
  twoFactorEmail              Boolean           @default(false)
  // App autenticador: segredo cifrado (AES-256-GCM, chave fora do banco), quando ligou e o último
  // passo de 30 s aceito, para o mesmo código não valer duas vezes. O "pendente" é o da configuração,
  // até a pessoa provar que o app funciona.
  totpSecret                  String?
  totpEnabledAt               DateTime?
  totpLastStep                Int?
  totpPendingSecret           String?
  // Último método usado no login ("EMAIL" ou "TOTP"): a tela "Confirme que é você" abre nele.
  twoFactorLastMethod         String?
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  authTokens      AuthToken[]
  activities      Activity[]
  appointments    Appointment[]
  schedules       AppointmentSchedule[]
  therapyPauses   TherapyPause[]
  actions         BehavioralAction[]
  thoughtRecords  ThoughtRecord[]
  tensionEpisodes TensionEpisode[]
  plans           Plan[]
  planEntries     PlanEntry[]
  recordLinks     RecordLink[]

  // Vínculo (DEC-015, DEC-031): o mesmo usuário pode estar dos dois lados, em vínculos diferentes.
  linksAsPatient            TherapistLink[]       @relation("LinkPatient")
  linksAsTherapist          TherapistLink[]       @relation("LinkTherapist")
  // Comunidade de apoio entre pacientes (DEC-113): conteúdo separado dos registros terapêuticos.
  ownedCommunity            Community?            @relation("CommunityOwner")
  communityMemberships      CommunityMembership[]
  communityPosts            CommunityPost[]       @relation("CommunityPostAuthor")
  communityComments         CommunityComment[]    @relation("CommunityCommentAuthor")
  communityReports          CommunityReport[]     @relation("CommunityReportAuthor")
  communityDecisions        CommunityPost[]       @relation("CommunityPostModerator")
  communityCommentDecisions CommunityComment[]    @relation("CommunityCommentModerator")
  reviewedCommunityReports  CommunityReport[]     @relation("CommunityReportModerator")
  // Marcas de leitura (DEC-057): as que esta conta fez como terapeuta e as que foram feitas nos
  // registros dela como paciente (só a terapeuta as vê).
  readMarksAsTherapist      ReadMark[]            @relation("ReadMarkTherapist")
  readMarksAsPatient        ReadMark[]            @relation("ReadMarkPatient")
  invitesSent               LinkInvite[]          @relation("InvitePatient")
  invitesSignedUp           LinkInvite[]          @relation("InviteSignupUser")
  linkCodes                 LinkCode[]
  linkCodeAttempts          LinkCodeAttempt[]
  // Mural de avisos (DEC-079): os avisos que esta conta publicou como terapeuta e os que ela já viu
  // como paciente.
  notices                   TherapistNotice[]
  // "Sobre mim" do paciente (DEC-081): um só por conta.
  about                     PatientAbout?
  noticesSeen               NoticeSeen[]

  // Lembretes e notificações (DEC-004, DEC-006, DEC-089): configuração, inscrições de Web Push e
  // registro de envio para idempotência.
  reminderSettings            ReminderSettings?
  pushSubscriptions           PushSubscription[]
  recoveryCodes               RecoveryCode[]
  twoFactorChallenges         TwoFactorChallenge[]
  notificationLogs            NotificationLog[]
  announcementEmailDeliveries AnnouncementEmailDelivery[]

  // Foto de perfil (DEC-061), opcional.
  avatar UserAvatar?
}

// Foto de perfil (DEC-061): guardada já reduzida (256×256, WebP) e sem metadados, como a
// localização que a câmera grava. Fica numa tabela à parte para a linha do User continuar leve e
// sai em cascata com a conta. O updatedAt vira a "versão" da foto, que o front usa no endereço
// da imagem para não mostrar uma antiga do cache.
model UserAvatar {
  userId    String   @id @db.Uuid
  image     Bytes
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Paletas de cores do app (DEC-063), todas conferidas no contraste (AA; Alto contraste em AAA).
enum Palette {
  SALVIA
  LAVANDA
  OCEANO
  AREIA
  ALTO_CONTRASTE
}

enum AuthTokenType {
  EMAIL_CONFIRMATION
  PASSWORD_RESET
}

// Links enviados por e-mail. O token em texto só existe no e-mail; aqui fica o hash (SHA-256).
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  // Confirmação de e-mail (DEC-072): os dados do cadastro que gerou este link. Confirmar aplica
  // esses dados na conta, e não os do primeiro cadastro. Assim, quem se cadastra antes com o
  // e-mail de outra pessoa não fica com a senha dela. Vazios nos outros tipos de link.
  pendingPasswordHash String?
  pendingName         String?
  pendingPatient      Boolean?
  pendingTherapist    Boolean?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Estados da SPEC. CONCLUIDA e NAO_REALIZADA são finais (DEC-012).
enum ActivityStatus {
  PLANEJADA
  PENDENTE
  CONCLUIDA
  NAO_REALIZADA
}

// Registro de atividade do paciente. Os campos exigidos por estado e a faixa das notas
// (inteiros de 0 a 10) são garantidos por CHECK na migration, além do Zod (DEC-028).
model Activity {
  id               String         @id @default(uuid()) @db.Uuid
  // O paciente dono do registro.
  userId           String         @db.Uuid
  name             String
  // Dia da atividade, no fuso America/Sao_Paulo (DEC-007). Separado do createdAt.
  activityDate     DateTime       @db.Date
  status           ActivityStatus
  // Vontade antes (0–10): exigida a partir de PENDENTE.
  wantBefore       Int?
  // Prazer e realização (0–10): só na CONCLUIDA.
  pleasure         Int?
  achievement      Int?
  // Só nos estados finais, e sempre opcional.
  observation      String?
  // Quando foi concluída (DEC-103): o prazo das fotos é a próxima consulta depois disso. As já
  // concluídas recebem o updatedAt na migration, porque concluída é final e só mudava ali.
  completedAt      DateTime?
  // O prazo das fotos, congelado como o da Ação (DEC-064): desmarcar ou apagar uma consulta que já
  // passou não reabre o prazo; antecipar a consulta encurta.
  photosDeadlineAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos ActivityPhoto[]

  @@index([userId, activityDate])
}

// Fotos de uma atividade (DEC-103), como as da Ação (DEC-064): até 10, guardadas já tratadas (sem
// metadados, como a localização), numa tabela à parte para as listas não carregarem imagens. Entram
// com a atividade aberta e na concluída até a próxima consulta. Saem em cascata com a atividade.
model ActivityPhoto {
  id         String   @id @default(uuid()) @db.Uuid
  activityId String   @db.Uuid
  image      Bytes
  thumbnail  Bytes
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, createdAt])
}

// Datas das consultas, registradas pelo paciente (DEC-017). Servem para "última" e "próxima"
// consulta e, na etapa de vínculo, para o filtro e o destaque da terapeuta.
// Consulta avulsa (DEC-030): uma sessão fora da recorrência, ou as de antes da agenda (DEC-045).
model Appointment {
  id              String    @id @default(uuid()) @db.Uuid
  // O paciente dono do registro.
  userId          String    @db.Uuid
  // Só o dia, no fuso America/Sao_Paulo (DEC-007).
  appointmentDate DateTime  @db.Date
  // Hora no relógio de São Paulo, sem segundos (DEC-045). Obrigatória nas novas; vazia nas
  // consultas registradas antes da agenda, que só tinham o dia.
  appointmentTime DateTime? @db.Time(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Uma consulta avulsa por dia (DEC-030); o choque com a recorrência é conferido no service.
  @@unique([userId, appointmentDate])
}

enum AppointmentFrequency {
  SEMANAL
  QUINZENAL
}

// Por que uma regra terminou: o paciente mudou dia, hora ou frequência, ou encerrou a terapia.
enum ScheduleEndReason {
  MUDANCA
  ENCERRAMENTO
}

// Regra da agenda (DEC-045): a primeira sessão, a hora e a frequência. As sessões são
// calculadas a partir dela, sem uma linha por sessão. Regras antigas ficam como histórico.
model AppointmentSchedule {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @db.Uuid
  // Primeira sessão: o dia da semana da recorrência sai dela.
  startDate DateTime             @db.Date
  // Hora no relógio de São Paulo, sem segundos.
  time      DateTime             @db.Time(0)
  frequency AppointmentFrequency
  // Último dia em que a regra vale (inclusive). null = a regra em vigor. Pode ficar antes do
  // startDate quando a regra termina sem nenhuma sessão.
  endDate   DateTime?            @db.Date
  endReason ScheduleEndReason?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  exceptions AppointmentException[]

  // Uma regra em vigor por paciente: índice único parcial na migration (WHERE "endDate" IS NULL).
  @@index([userId])
}

enum AppointmentExceptionType {
  DESMARCADA
  REMARCADA
}

// O que mudou numa sessão específica da recorrência, sempre com o motivo (DEC-045).
model AppointmentException {
  id           String                   @id @default(uuid()) @db.Uuid
  scheduleId   String                   @db.Uuid
  // O dia em que a sessão cairia pela regra.
  originalDate DateTime                 @db.Date
  type         AppointmentExceptionType
  // Só na remarcada: o novo dia e a nova hora.
  newDate      DateTime?                @db.Date
  newTime      DateTime?                @db.Time(0)
  reason       String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  schedule AppointmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, originalDate])
}

// Pausa na terapia (DEC-045): sem sessões de startDate até a véspera do returnDate.
// Sem returnDate, a pausa vale até o paciente retomar.
model TherapyPause {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  startDate  DateTime  @db.Date
  returnDate DateTime? @db.Date
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Emoções do Registro de Pensamentos (SPEC, "Registro de Pensamentos"; DEC-039).
// OUTRA vem com o nome escrito pelo paciente (otherLabel).
enum Emotion {
  TRISTEZA
  ANSIEDADE
  MEDO
  RAIVA
  CULPA
  VERGONHA
  FRUSTRACAO
  SOLIDAO
  ALEGRIA
  ALIVIO
  OUTRA
}

// Registro de Pensamentos (RPD) do paciente. Todos os campos são obrigatórios; tamanhos e a
// faixa da crença (0–10) são garantidos por CHECK na migration, além do Zod (DEC-039).
// Editar e excluir só no dia (São Paulo) em que foi registrado, conferido pelo createdAt.
model ThoughtRecord {
  id                     String    @id @default(uuid()) @db.Uuid
  // O paciente dono do registro.
  userId                 String    @db.Uuid
  // Dia da situação, no fuso America/Sao_Paulo (DEC-007). Só até hoje; separado do createdAt.
  situationDate          DateTime  @db.Date
  situation              String
  automaticThought       String
  // O quanto acredita no pensamento (0–10).
  beliefLevel            Int
  behavior               String
  consequence            String
  // Explicação alternativa (DEC-054): opcional. Depois do dia do registro, pode ser adicionada uma
  // vez, até a hora da próxima consulta. alternativeAddedAt diz quando entrou (CHECK: os dois
  // juntos), para a terapeuta saber se veio no dia ou depois.
  alternativeExplanation String?
  alternativeAddedAt     DateTime?
  // Prazo congelado no momento do registro: a hora da próxima consulta naquele momento. Vale o que
  // vier primeiro, ele ou a agenda atual, para mexer no passado da agenda não reabrir o prazo.
  // null = sem consulta agendada quando o registro foi feito (ou registro de antes do prazo).
  alternativeDeadlineAt  DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  emotions  ThoughtRecordEmotion[]
  readMarks ReadMark[]

  @@index([userId, situationDate])
}

// Emoções de um registro: uma ou mais, sem repetir, cada uma com intensidade de 0 a 10.
model ThoughtRecordEmotion {
  id             String  @id @default(uuid()) @db.Uuid
  recordId       String  @db.Uuid
  emotion        Emotion
  intensity      Int
  // "Como me sinto agora" (DEC-054): a intensidade depois da explicação alternativa, de 0 a 10.
  // Só com a alternativa, e em todas as emoções do registro ou em nenhuma (conferido no service).
  intensityAfter Int?
  // Só na OUTRA, e obrigatório nela (CHECK na migration).
  otherLabel     String?

  record ThoughtRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, emotion])
}

// Episódio de tensão do paciente (SPEC, "Episódios de tensão"; DEC-042). Tudo obrigatório, menos a
// hora. Tamanhos e a faixa das notas (0–10) são garantidos por CHECK na migration, além do Zod.
// Editar e excluir só no dia (São Paulo) em que foi registrado, conferido pelo createdAt.
model TensionEpisode {
  id           String    @id @default(uuid()) @db.Uuid
  // O paciente dono do registro.
  userId       String    @db.Uuid
  // Dia do episódio, no fuso America/Sao_Paulo (DEC-007). Só até hoje; separado do createdAt.
  episodeDate  DateTime  @db.Date
  // Hora do episódio no relógio de São Paulo, sem segundos. Opcional: a pessoa pode não lembrar.
  episodeTime  DateTime? @db.Time(0)
  situation    String
  // Tensão e vontade de vocalizar (tique vocal ou de ansiedade: falar, gritar, se mexer), 0–10.
  tensionLevel Int
  vocalizeUrge Int
  // O que a pessoa fez e o que aconteceu depois.
  behavior     String
  consequence  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  readMarks ReadMark[]

  @@index([userId, episodeDate])
}

// Meus Planos (DEC-094): um plano de ação do paciente, com o gatilho no título ("Quando surgir
// vontade de…") e perguntas próprias, de 1 a 10, com 1 a 200 caracteres cada (CHECK na migration).
// Nesta 1ª entrega só o paciente escreve; a terapeuta com vínculo ativo só lê.
model Plan {
  id         String    @id @default(uuid()) @db.Uuid
  // O paciente dono do plano.
  userId     String    @db.Uuid
  // De 1 a 120 caracteres. Texto de saúde: nunca em log nem em notificação.
  title      String
  questions  String[]
  // Preenchido = encerrado: sai da lista principal e não recebe registro novo. Dá para reabrir.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries PlanEntry[]

  @@index([userId])
}

// Cada vez que a situação do plano acontece (DEC-094). Guarda uma cópia das perguntas como estavam
// no registro: mudar o plano depois não muda o sentido de um registro antigo. As respostas seguem
// a ordem das perguntas; texto vazio = não respondida, mas pelo menos uma tem texto (CHECK).
model PlanEntry {
  id        String    @id @default(uuid()) @db.Uuid
  planId    String    @db.Uuid
  // Repete o dono do plano, para conferir a autorização e listar sem passar pelo plano.
  userId    String    @db.Uuid
  // Dia do momento, no fuso America/Sao_Paulo (DEC-007). Só até hoje; separado do createdAt.
  entryDate DateTime  @db.Date
  // Hora do momento no relógio de São Paulo, sem segundos. Opcional, como na Tensão.
  entryTime DateTime? @db.Time(0)
  questions String[]
  answers   String[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  plan      Plan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  readMarks ReadMark[]

  @@index([planId, entryDate])
  @@index([userId])
}

enum LinkMethod {
  INVITE
  CODE
}

// O tipo de quem acompanha o paciente (DEC-097). No máximo uma profissional de cada tipo por paciente.
enum ProfessionalKind {
  PSICOLOGIA
  PSIQUIATRIA
}

// As áreas que o paciente libera para cada profissional (DEC-097). As fotos da Ação têm caixa própria.
enum SharedArea {
  ACTIVITIES
  // Fotos das atividades (DEC-103): caixa própria, como as fotos da Ação. Vínculos que já liberavam
  // as atividades começam sem elas.
  ACTIVITY_PHOTOS
  THOUGHT_RECORDS
  TENSION_EPISODES
  ACTIONS
  ACTION_PHOTOS
  ABOUT_ME
  APPOINTMENTS
  PLANS
  TASKS
  // Sono e humor e o remédio do dia (DEC-107): caixas próprias, fechadas nos vínculos que já existiam.
  SLEEP_MOOD
  MEDICATION
  // Remédios, mudanças e o que o paciente sente (DEC-114): caixa própria, fechada nos vínculos que já
  // existiam. A caixa MEDICATION continua só com o "tomou como combinado?".
  MEDICATIONS
}

// Registros que podem ser ligados entre si (DEC-111). Sono e Remédio são subtipos do mesmo
// DailyCheckIn, separados para não misturar as permissões próprias dessas áreas.
enum LinkedRecordType {
  ACTIVITY
  THOUGHT_RECORD
  TENSION_EPISODE
  ACTION
  PLAN
  PLAN_ENTRY
  TASK
  SLEEP_MOOD
  MEDICATION
}

enum RecordLinkKind {
  RELATED
  REPETITION
}

// Estados da participação na comunidade de apoio (DEC-113).
enum CommunityMembershipStatus {
  INVITED
  REQUESTED
  ACTIVE
  LEFT
  SUSPENDED
  REJECTED
}

// Autoria e revisão humana do conteúdo da comunidade (DEC-113).
enum CommunityAuthorKind {
  PATIENT
  THERAPIST
}

enum CommunityContentStatus {
  PENDING
  PUBLISHED
  REJECTED
  HIDDEN
  DELETED
}

enum CommunityReportReason {
  HARASSMENT
  PRIVACY
  UNSAFE_ADVICE
  OTHER
}

enum CommunityReportStatus {
  OPEN
  REVIEWED
}

// Vínculo paciente ↔ terapeuta (SPEC, "Vínculo"). Revogar preenche revokedAt e o registro fica.
// Escritos à mão na migration: no máximo um vínculo ativo por paciente e tipo (índice único parcial, DEC-097)
// e ninguém se vincula a si mesmo (CHECK).
model TherapistLink {
  messages                PrivateMessage[]
  agreedTasks             HomeworkTask[]
  id                      String           @id @default(uuid()) @db.Uuid
  patientId               String           @db.Uuid
  therapistId             String           @db.Uuid
  method                  LinkMethod
  createdAt               DateTime         @default(now())
  revokedAt               DateTime?
  // O tipo da profissional no momento do vínculo (DEC-097): o índice único parcial usa ele.
  kind                    ProfessionalKind
  // O que o paciente liberou para esta profissional. Vínculo novo começa sem nada; os que já
  // existiam ganharam todas as áreas na migration, para nada mudar para quem já usava.
  sharedAreas             SharedArea[]     @default([])
  // null = o paciente ainda não viu o aviso de novo vínculo no app.
  seenByPatientAt         DateTime?
  // "Lido" para o paciente (DEC-117): só aparece com os dois lados ligados. O paciente pede
  // (requestedAt) e a profissional ativa (sharedAt) ou responde "Agora não" (notNowAt), que só
  // esconde o aviso dela. O paciente nunca vê a recusa. Desligar do lado do paciente zera os três.
  readReceiptsRequestedAt DateTime?
  readReceiptsSharedAt    DateTime?
  readReceiptsNotNowAt    DateTime?
  // Mensagens (DEC-127): até que mensagem cada pessoa viu a conversa (hora da mais recente que ela
  // abriu), só para o selo "Nova" dela. A API nunca mostra o "visto" de um ao outro (sem recibo de
  // leitura, DEC-125).
  patientMessagesSeenAt   DateTime?
  therapistMessagesSeenAt DateTime?

  patient   User @relation("LinkPatient", fields: [patientId], references: [id], onDelete: Cascade)
  therapist User @relation("LinkTherapist", fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([therapistId])
}

// Conversa privada por vínculo. Excluir qualquer uma das contas apaga o vínculo e as mensagens.
model PrivateMessage {
  id            String            @id @default(uuid()) @db.Uuid
  linkId        String            @db.Uuid
  sentByPatient Boolean
  topic         MessageTopic
  body          String
  createdAt     DateTime          @default(now())
  // Assunto "Sobre um registro" (DEC-128): só a referência ao registro do paciente, nunca uma cópia.
  // A API confere o acesso a cada leitura; os dois ficam juntos (CHECK escrito à mão).
  recordType    LinkedRecordType?
  recordId      String?           @db.Uuid
  link          TherapistLink     @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId, createdAt, id])
}

enum MessageTopic {
  LOGISTICA
  DUVIDA
  // DEC-128: a mensagem aponta um registro do paciente.
  REGISTRO
}

// Convite por e-mail. Não expira e vale uma vez; o token em texto só existe no e-mail (regra 8).
// Escrito à mão na migration: no máximo um convite pendente por paciente.
model LinkInvite {
  id             String    @id @default(uuid()) @db.Uuid
  patientId      String    @db.Uuid
  // Para onde o convite foi enviado. Quem aceita pode usar outra conta (DEC-031).
  therapistEmail String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  acceptedAt     DateTime?
  canceledAt     DateTime?
  // Conta criada pelo link do convite: o vínculo nasce quando ela confirmar o e-mail.
  signupUserId   String?   @db.Uuid

  patient    User  @relation("InvitePatient", fields: [patientId], references: [id], onDelete: Cascade)
  signupUser User? @relation("InviteSignupUser", fields: [signupUserId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([signupUserId])
}

// Código de vínculo: 24 h, uma vez, invalidado ao gerar outro. Guardado como HMAC (DEC-031).
model LinkCode {
  id        String    @id @default(uuid()) @db.Uuid
  patientId String    @db.Uuid
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// Tentativas erradas de código, por terapeuta: 5 em 15 minutos bloqueiam (SPEC). Fica no banco,
// e não em memória, para o bloqueio sobreviver a um deploy.
model LinkCodeAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  therapistId String   @db.Uuid
  createdAt   DateTime @default(now())

  therapist User @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId, createdAt])
}

enum ActionCategory {
  PRAZER
  CONEXAO
  REALIZACAO
}

enum ActionStatus {
  PLANEJADA
  AVALIADA
  NAO_REALIZADA
}

// Ação (DEC-051): uma ação de prazer, de conexão ou de realização, planejada com a expectativa e
// avaliada depois com o prazer e a realização. Avaliada e não realizada são finais.
model BehavioralAction {
  id               String         @id @default(uuid()) @db.Uuid
  // O paciente dono do registro.
  userId           String         @db.Uuid
  // Dia da ação, no fuso America/Sao_Paulo (DEC-007); separado do createdAt.
  actionDate       DateTime       @db.Date
  name             String
  category         ActionCategory
  status           ActionStatus   @default(PLANEJADA)
  // Expectativa antes (0–10), sempre; prazer e realização depois (0–10), só na avaliada.
  expectation      Int
  pleasure         Int?
  achievement      Int?
  // Opcional na avaliada e na não realizada.
  observation      String?
  // Quando foi avaliada (DEC-064): o prazo das fotos é a próxima consulta depois disso.
  evaluatedAt      DateTime?
  // O prazo das fotos, congelado como o da alternativa no RPD (DEC-054): desmarcar ou apagar uma
  // consulta que já passou não reabre o prazo; antecipar a consulta encurta.
  photosDeadlineAt DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  readMarks ReadMark[]
  photos    ActionPhoto[]

  @@index([userId, actionDate])
}

// Fotos de uma Ação avaliada (DEC-064): até 10, guardadas já tratadas (sem metadados, como a
// localização), numa tabela à parte para as listas não carregarem imagens. A grande cabe em
// 2560 px; a miniatura é um quadrado de 400 px para os cartões. Saem em cascata com a ação.
model ActionPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  actionId  String   @db.Uuid
  image     Bytes
  thumbnail Bytes
  createdAt DateTime @default(now())

  action BehavioralAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, createdAt])
}

// Marca de leitura da terapeuta (SPEC, "Visão da terapeuta"; DEC-057): "lido" num Pensamento, num
// Episódio de tensão ou numa Ação de um paciente vinculado. É a única escrita da terapeuta sobre os
// registros de um paciente, e não altera o registro: só esta tabela. O paciente não vê as marcas.
// Uma coluna por área, com CHECK de exatamente uma preenchida: a marca some em cascata com o
// registro ou com qualquer uma das contas.
model ReadMark {
  id               String   @id @default(uuid()) @db.Uuid
  therapistId      String   @db.Uuid
  // O dono dos registros, para contar os não lidos por paciente sem passar pelas três tabelas.
  patientId        String   @db.Uuid
  thoughtRecordId  String?  @db.Uuid
  tensionEpisodeId String?  @db.Uuid
  actionId         String?  @db.Uuid
  // "Sobre mim" do paciente (DEC-081): também entra no "Para ler".
  aboutId          String?  @db.Uuid
  // Registro de um plano de "Meus Planos" (DEC-094). O plano em si não entra no "Para ler".
  planEntryId      String?  @db.Uuid
  taskId           String?  @db.Uuid
  // Quando foi lido. Se o registro mudar depois (updatedAt maior), volta a contar como não lido.
  readAt           DateTime @default(now())

  therapist      User              @relation("ReadMarkTherapist", fields: [therapistId], references: [id], onDelete: Cascade)
  patient        User              @relation("ReadMarkPatient", fields: [patientId], references: [id], onDelete: Cascade)
  thoughtRecord  ThoughtRecord?    @relation(fields: [thoughtRecordId], references: [id], onDelete: Cascade)
  tensionEpisode TensionEpisode?   @relation(fields: [tensionEpisodeId], references: [id], onDelete: Cascade)
  action         BehavioralAction? @relation(fields: [actionId], references: [id], onDelete: Cascade)
  about          PatientAbout?     @relation(fields: [aboutId], references: [id], onDelete: Cascade)
  planEntry      PlanEntry?        @relation(fields: [planEntryId], references: [id], onDelete: Cascade)

  task HomeworkTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([therapistId, taskId])
  // Uma marca por terapeuta e registro. NULL não colide no Postgres: vale para a coluna preenchida.
  @@unique([therapistId, thoughtRecordId])
  @@unique([therapistId, tensionEpisodeId])
  @@unique([therapistId, actionId])
  @@unique([therapistId, aboutId])
  @@unique([therapistId, planEntryId])
  @@index([therapistId, patientId])
}

// Mural de avisos da terapeuta (DEC-079): mensagem de mão única para todos os pacientes com vínculo
// ativo. É conteúdo da terapeuta, e não dado de paciente: ela cria, edita e apaga os próprios avisos.
// Os pacientes não se veem entre si e não comentam. O texto tem de 1 a 2000 caracteres (CHECK na
// migration) e some com a conta dela.
model TherapistNotice {
  id          String   @id @default(uuid()) @db.Uuid
  therapistId String   @db.Uuid
  body        String
  createdAt   DateTime @default(now())
  // Maior que o createdAt = editado. Editar não faz o aviso voltar a ser "novo" para o paciente.
  updatedAt   DateTime @updatedAt

  therapist User         @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  seenBy    NoticeSeen[]

  @@index([therapistId, createdAt])
}

// O "já vi" do paciente num aviso do mural (DEC-079): tira o selo "Novo". Só o próprio paciente lê;
// a terapeuta não sabe quem viu. Some com o aviso ou com a conta do paciente.
model NoticeSeen {
  noticeId  String   @db.Uuid
  patientId String   @db.Uuid
  seenAt    DateTime @default(now())

  notice  TherapistNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  patient User            @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@id([noticeId, patientId])
  @@index([patientId])
}

// Comunidade opcional de apoio de uma psicóloga. Excluir a conta da psicóloga apaga a comunidade e
// os conteúdos em cascata; o paciente pode apagar os próprios conteúdos antes disso (DEC-113).
model Community {
  id                         String             @id @default(uuid()) @db.Uuid
  therapistId                String             @unique @db.Uuid
  // Última pessoa revisora comunicada aos membros; permite avisar quando o 2FA pausa a revisão.
  announcedModerator         CommunityModerator @default(PLATFORM)
  // A escolha da psicóloga é opcional; sem ela, a equipe da plataforma revisa (DEC-122).
  therapistModerationEnabled Boolean            @default(false)
  createdAt                  DateTime           @default(now())

  therapist   User                  @relation("CommunityOwner", fields: [therapistId], references: [id], onDelete: Cascade)
  memberships CommunityMembership[]
  posts       CommunityPost[]
  events      CommunityEvent[]
  reports     CommunityReport[]
}

enum CommunityModerator {
  PLATFORM
  THERAPIST
}

// Participação opcional do paciente. A confirmação 18+ guarda somente a data, nunca a data de
// nascimento. A adesão depende de vínculo ativo com a psicóloga e aprovação dela (DEC-113).
model CommunityMembership {
  id               String                    @id @default(uuid()) @db.Uuid
  communityId      String                    @db.Uuid
  patientId        String                    @db.Uuid
  status           CommunityMembershipStatus @default(REQUESTED)
  displayName      String?
  acceptedRulesAt  DateTime?
  adultConfirmedAt DateTime?
  announceOnJoin   Boolean                   @default(false)
  requestedAt      DateTime?
  invitedAt        DateTime?
  joinedAt         DateTime?
  leftAt           DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  patient   User      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([communityId, patientId])
  @@index([communityId, status, createdAt])
}

// Publicação que só aparece para a comunidade depois da revisão humana (DEC-113).
model CommunityPost {
  id                String                 @id @default(uuid()) @db.Uuid
  communityId       String                 @db.Uuid
  authorId          String                 @db.Uuid
  authorKind        CommunityAuthorKind
  authorDisplayName String
  body              String
  status            CommunityContentStatus @default(PENDING)
  moderationMessage String?
  reviewedAt        DateTime?
  moderatorId       String?                @db.Uuid
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  community Community          @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User               @relation("CommunityPostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderator User?              @relation("CommunityPostModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  comments  CommunityComment[]
  reports   CommunityReport[]

  @@index([communityId, status, createdAt])
  @@index([authorId, createdAt])
}

// Comentários sem resposta encadeada, também revisados antes de aparecer (DEC-113).
model CommunityComment {
  id                String                 @id @default(uuid()) @db.Uuid
  postId            String                 @db.Uuid
  authorId          String                 @db.Uuid
  authorKind        CommunityAuthorKind
  authorDisplayName String
  body              String
  status            CommunityContentStatus @default(PENDING)
  moderationMessage String?
  reviewedAt        DateTime?
  moderatorId       String?                @db.Uuid
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  post      CommunityPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User              @relation("CommunityCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderator User?             @relation("CommunityCommentModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  reports   CommunityReport[]

  @@index([postId, status, createdAt])
  @@index([authorId, createdAt])
}

// Aviso opcional de boas-vindas no feed, sem expor a identidade da conta (DEC-113).
model CommunityEvent {
  id          String   @id @default(uuid()) @db.Uuid
  communityId String   @db.Uuid
  body        String
  createdAt   DateTime @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, createdAt])
}

// Denúncias feitas por membros. Cada alvo é uma publicação ou um comentário (CHECK na migration).
model CommunityReport {
  id          String                @id @default(uuid()) @db.Uuid
  communityId String                @db.Uuid
  reporterId  String                @db.Uuid
  postId      String?               @db.Uuid
  commentId   String?               @db.Uuid
  reason      CommunityReportReason
  details     String?
  status      CommunityReportStatus @default(OPEN)
  reviewedAt  DateTime?
  moderatorId String?               @db.Uuid
  createdAt   DateTime              @default(now())

  community Community         @relation(fields: [communityId], references: [id], onDelete: Cascade)
  reporter  User              @relation("CommunityReportAuthor", fields: [reporterId], references: [id], onDelete: Cascade)
  post      CommunityPost?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  moderator User?             @relation("CommunityReportModerator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([communityId, status, createdAt])
  @@index([reporterId, createdAt])
}

// Contas excluídas nas últimas 5 semanas, só pelo id (DEC-077). Se um dia for preciso restaurar uma
// cópia de segurança (DEC-075), estas contas são apagadas de novo, para ninguém voltar depois de
// excluir. Sem relação com o User (ele já não existe) e sem nome nem e-mail: fora das cópias de
// segurança, o id não identifica ninguém. Some depois de 35 dias, depois das próprias cópias.
model DeletedAccount {
  userId    String   @id @db.Uuid
  deletedAt DateTime @default(now())
}

// "Sobre mim" do paciente (DEC-081): o que ele quiser contar, tudo opcional, em texto livre (até
// 2000 caracteres por campo, CHECK no banco). A terapeuta com vínculo ativo só lê. Sem nenhum campo
// preenchido, o registro não existe (salvar tudo vazio apaga). Dado de saúde: fora dos logs.
model PatientAbout {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  // "Sobre mim": rotina, gostos, o que é importante.
  aboutMe   String?
  // "O que eu gostaria de trabalhar".
  goals     String?
  // "Hábitos que quero deixar (ou já deixei)".
  habits    String?
  createdAt DateTime @default(now())
  // Mudou depois de lido: volta para o "Para ler" da terapeuta (DEC-057).
  updatedAt DateTime @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  readMarks ReadMark[]
}

// Canal único de lembrete escolhido na conta (DEC-089, issue #32/#82). Se o PUSH falhar ou expirar,
// o envio cai para o EMAIL e grava lastFallbackAt.
enum ReminderChannel {
  EMAIL
  PUSH
}

// Tipos de lembrete do paciente (SPEC, "Lembretes"; DEC-089).
enum ReminderType {
  MANHA
  NOITE
}

// Configuração dos lembretes do paciente (DEC-089, issue #32): canal único, manhã e noite em
// intervalos de 15 minutos (CHECK no banco), horário de silêncio ajustável e pausa temporária.
model ReminderSettings {
  userId            String          @id @db.Uuid
  channel           ReminderChannel @default(EMAIL)
  morningEnabled    Boolean         @default(false)
  morningTime       DateTime        @db.Time(0)
  eveningEnabled    Boolean         @default(false)
  eveningTime       DateTime        @db.Time(0)
  quietHoursEnabled Boolean         @default(true)
  quietStart        DateTime        @db.Time(0)
  quietEnd          DateTime        @db.Time(0)
  // Até este dia (inclusive, no fuso America/Sao_Paulo), nenhum lembrete sai.
  pausedUntil       DateTime?       @db.Date
  // Quando um lembrete escolhido como PUSH precisou cair para o e-mail (para avisar no app).
  lastFallbackAt    DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Inscrições de Web Push por aparelho (DEC-004, DEC-089). Ligadas ao sessionId do JWT (DEC-085)
// para "Sair de todos" apagar todas e "Trocar senha" apagar as dos outros aparelhos.
model PushSubscription {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  sessionId String?
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Registro de envio de lembretes (DEC-006, DEC-089): chave única (userId, type, referenceDate)
// garante idempotência mesmo que a API reinicie ou o agendador rode mais de uma vez.
model NotificationLog {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @db.Uuid
  type          ReminderType
  referenceDate DateTime        @db.Date
  channelUsed   ReminderChannel
  sentAt        DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, referenceDate])
  @@index([referenceDate])
}

// Um envio por pessoa e novidade. A chave única e a chave de idempotência do Resend permitem
// retomar tentativas sem repetir a mensagem (DEC-119).
model AnnouncementEmailDelivery {
  id             String                  @id @default(uuid()) @db.Uuid
  userId         String                  @db.Uuid
  announcementId String
  status         AnnouncementEmailStatus @default(PENDING)
  attempts       Int                     @default(0)
  nextAttemptAt  DateTime                @default(now())
  lockedUntil    DateTime?
  firstAttemptAt DateTime?
  sentAt         DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement AnnouncementRelease @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, announcementId])
  @@index([status, nextAttemptAt])
}

// Data em que a novidade entrou no ar. Criada no primeiro início da API após o front publicar o
// mesmo id (DEC-056), exclui contas criadas depois e evita avisos retroativos (DEC-119).
model AnnouncementRelease {
  id          String                      @id
  publishedAt DateTime                    @default(now())
  deliveries  AnnouncementEmailDelivery[]
}

// Códigos de recuperação do 2FA (DEC-092): 10 por vez, cada um vale uma vez. Só o HMAC é guardado.
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Um desafio do 2FA (DEC-092): o passo do login entre a senha e o código ("LOGIN"), ou a
// confirmação do código por e-mail numa ação com a sessão aberta ("ACTION": ativar ou desligar).
// O código por e-mail é guardado só como HMAC, vale 10 min e uma vez; no máximo 5 tentativas.
model TwoFactorChallenge {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  purpose            String
  emailCodeHash      String?
  emailCodeExpiresAt DateTime?
  emailSends         Int       @default(0)
  lastEmailSentAt    DateTime?
  attempts           Int       @default(0)
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Tarefa única combinada na consulta, criada e respondida pelo paciente (DEC-103).
// A descrição não muda depois da primeira resposta. O prazo congelado impede reabertura.
enum TaskResponseStatus {
  RESPONDIDA
  NAO_CONSEGUI
  NAO_FAZ_SENTIDO
}

model HomeworkTask {
  id                 String              @id @default(uuid()) @db.Uuid
  userId             String              @db.Uuid
  title              String?
  description        String
  agreedLinkId       String?             @db.Uuid
  responseStatus     TaskResponseStatus?
  responseText       String?
  respondedAt        DateTime?
  responseDeadlineAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  agreedLink TherapistLink? @relation(fields: [agreedLinkId], references: [id], onDelete: SetNull)
  readMarks  ReadMark[]

  @@index([userId, createdAt])
}

// Sono, humor e remédio (DEC-107, #188 e #171). Um registro por dia, todo opcional: a noite pertence
// ao dia em que a pessoa acordou. O paciente registra e edita os últimos 7 dias. O remédio é só se
// tomou como combinado: o Faísca não guarda nome nem dose.
enum MedicationTaken {
  TOMOU
  ESQUECEU_ALGUM
  NAO_TOMOU
}

model DailyCheckIn {
  id           String           @id @default(uuid()) @db.Uuid
  userId       String           @db.Uuid
  checkInDate  DateTime         @db.Date
  // Os dois horários vêm juntos (CHECK); as horas de sono são calculadas na leitura.
  bedTime      DateTime?        @db.Time(0)
  wakeTime     DateTime?        @db.Time(0)
  sleepQuality Int?             @db.SmallInt
  mood         Int?             @db.SmallInt
  // Uma palavra para o dia (texto do paciente: fora dos logs e do resumo).
  moodWord     String?
  medication   MedicationTaken?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, checkInDate])
}

// Remédios e o que sinto (DEC-114, #171). Tudo é anotação do paciente, em texto livre e sem catálogo:
// o Faísca não avalia remédio nem sintoma. O paciente edita e apaga tudo (não são registros finais).
enum MedicationChangeKind {
  COMECOU
  MUDOU_DOSE
  PAROU
}

// Um remédio. A dose atual e se está em uso saem das mudanças (a última, pela data).
model Medication {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  // Nome e horário em texto livre (texto do paciente: fora dos logs).
  name      String
  schedule  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  changes  MedicationChange[]
  symptoms Symptom[]

  @@index([userId])
}

// Linha do tempo do remédio: começou, mudou a dose ou parou, sempre com data. A primeira é um
// COMECOU, criada junto com o remédio; depois de PAROU, só um novo COMECOU (voltou a tomar).
model MedicationChange {
  id           String               @id @default(uuid()) @db.Uuid
  medicationId String               @db.Uuid
  kind         MedicationChangeKind
  changeDate   DateTime             @db.Date
  // A dose a partir desta mudança (COMECOU e MUDOU_DOSE); vazia no PAROU.
  dose         String?
  note         String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)

  @@index([medicationId, changeDate])
}

// O que o paciente tem sentido. A ligação com um remédio é opcional ("começou depois de algum remédio
// ou mudança?") e não afirma que o sintoma é dele.
model Symptom {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  description  String
  startedOn    DateTime  @db.Date
  // "Já passou": vazio enquanto continua.
  endedOn      DateTime? @db.Date
  medicationId String?   @db.Uuid
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  medication Medication?    @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  checks     SymptomCheck[]

  @@index([userId])
}

// "Como está agora": a intensidade de 0 a 10 num dia, uma por dia, para ver a evolução do começo do
// remédio para o uso contínuo.
model SymptomCheck {
  id        String   @id @default(uuid()) @db.Uuid
  symptomId String   @db.Uuid
  checkedOn DateTime @db.Date
  intensity Int      @db.SmallInt
  createdAt DateTime @default(now())

  symptom Symptom @relation(fields: [symptomId], references: [id], onDelete: Cascade)

  @@unique([symptomId, checkedOn])
}

// Ligação entre registros do mesmo paciente (DEC-111). Os ids são polimórficos; a API confere
// dono e área para cada ponta, e apaga/ajusta as ligações junto com a exclusão do registro.
// Nas ligações RELATED, source/target são normalizados para deduplicar o par; em REPETITION,
// source é a raiz da família e target é a nova ocorrência.
model RecordLink {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @db.Uuid
  sourceType LinkedRecordType
  sourceId   String           @db.Uuid
  targetType LinkedRecordType
  targetId   String           @db.Uuid
  kind       RecordLinkKind   @default(RELATED)
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId, targetType, targetId, kind])
  @@index([userId, sourceType, sourceId])
  @@index([userId, targetType, targetId])
}
