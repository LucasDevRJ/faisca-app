// Schema do Faísca. Os models entram por etapa (usuários, atividades, consultas, vínculos).
// A URL do banco fica no prisma.config.ts (CLI) e em src/lib/prisma.ts (runtime).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  // Sempre em minúsculas e sem espaços nas pontas (normalizado no schema Zod).
  email               String    @unique
  passwordHash        String
  // Pelo menos um dos dois é true: garantido por CHECK na migration (DEC-013).
  hasPatientProfile   Boolean   @default(false)
  hasTherapistProfile Boolean   @default(false)
  // null = e-mail ainda não confirmado; o login é recusado até confirmar.
  emailConfirmedAt    DateTime?
  // Vai dentro do JWT. Ao redefinir a senha, sobe e derruba as sessões abertas (DEC-025).
  sessionVersion      Int       @default(0)
  // Consentimento com o aviso de privacidade (LGPD, dado de saúde; DEC-036): quando e qual versão.
  // null só em contas criadas antes do aviso existir.
  privacyAcceptedAt   DateTime?
  privacyVersion      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  authTokens   AuthToken[]
  activities   Activity[]
  appointments Appointment[]

  // Vínculo (DEC-015, DEC-031): o mesmo usuário pode estar dos dois lados, em vínculos diferentes.
  linksAsPatient   TherapistLink[]   @relation("LinkPatient")
  linksAsTherapist TherapistLink[]   @relation("LinkTherapist")
  invitesSent      LinkInvite[]      @relation("InvitePatient")
  invitesSignedUp  LinkInvite[]      @relation("InviteSignupUser")
  linkCodes        LinkCode[]
  linkCodeAttempts LinkCodeAttempt[]
}

enum AuthTokenType {
  EMAIL_CONFIRMATION
  PASSWORD_RESET
}

// Links enviados por e-mail. O token em texto só existe no e-mail; aqui fica o hash (SHA-256).
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Estados da SPEC. CONCLUIDA e NAO_REALIZADA são finais (DEC-012).
enum ActivityStatus {
  PLANEJADA
  PENDENTE
  CONCLUIDA
  NAO_REALIZADA
}

// Registro de atividade do paciente. Os campos exigidos por estado e a faixa das notas
// (inteiros de 0 a 10) são garantidos por CHECK na migration, além do Zod (DEC-028).
model Activity {
  id           String         @id @default(uuid()) @db.Uuid
  // O paciente dono do registro.
  userId       String         @db.Uuid
  name         String
  // Dia da atividade, no fuso America/Sao_Paulo (DEC-007). Separado do createdAt.
  activityDate DateTime       @db.Date
  status       ActivityStatus
  // Vontade antes (0–10): exigida a partir de PENDENTE.
  wantBefore   Int?
  // Prazer e realização (0–10): só na CONCLUIDA.
  pleasure     Int?
  achievement  Int?
  // Só nos estados finais, e sempre opcional.
  observation  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, activityDate])
}

// Datas das consultas, registradas pelo paciente (DEC-017). Servem para "última" e "próxima"
// consulta e, na etapa de vínculo, para o filtro e o destaque da terapeuta.
model Appointment {
  id              String   @id @default(uuid()) @db.Uuid
  // O paciente dono do registro.
  userId          String   @db.Uuid
  // Só o dia, no fuso America/Sao_Paulo (DEC-007).
  appointmentDate DateTime @db.Date
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Uma consulta por dia (DEC-030).
  @@unique([userId, appointmentDate])
}

enum LinkMethod {
  INVITE
  CODE
}

// Vínculo paciente ↔ terapeuta (SPEC, "Vínculo"). Revogar preenche revokedAt e o registro fica.
// Escritos à mão na migration: no máximo um vínculo ativo por paciente (índice único parcial)
// e ninguém se vincula a si mesmo (CHECK).
model TherapistLink {
  id              String     @id @default(uuid()) @db.Uuid
  patientId       String     @db.Uuid
  therapistId     String     @db.Uuid
  method          LinkMethod
  createdAt       DateTime   @default(now())
  revokedAt       DateTime?
  // null = o paciente ainda não viu o aviso de novo vínculo no app.
  seenByPatientAt DateTime?

  patient   User @relation("LinkPatient", fields: [patientId], references: [id], onDelete: Cascade)
  therapist User @relation("LinkTherapist", fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([therapistId])
}

// Convite por e-mail. Não expira e vale uma vez; o token em texto só existe no e-mail (regra 8).
// Escrito à mão na migration: no máximo um convite pendente por paciente.
model LinkInvite {
  id             String    @id @default(uuid()) @db.Uuid
  patientId      String    @db.Uuid
  // Para onde o convite foi enviado. Quem aceita pode usar outra conta (DEC-031).
  therapistEmail String
  tokenHash      String    @unique
  createdAt      DateTime  @default(now())
  acceptedAt     DateTime?
  canceledAt     DateTime?
  // Conta criada pelo link do convite: o vínculo nasce quando ela confirmar o e-mail.
  signupUserId   String?   @db.Uuid

  patient    User  @relation("InvitePatient", fields: [patientId], references: [id], onDelete: Cascade)
  signupUser User? @relation("InviteSignupUser", fields: [signupUserId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([signupUserId])
}

// Código de vínculo: 24 h, uma vez, invalidado ao gerar outro. Guardado como HMAC (DEC-031).
model LinkCode {
  id        String    @id @default(uuid()) @db.Uuid
  patientId String    @db.Uuid
  codeHash  String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  patient User @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

// Tentativas erradas de código, por terapeuta: 5 em 15 minutos bloqueiam (SPEC). Fica no banco,
// e não em memória, para o bloqueio sobreviver a um deploy.
model LinkCodeAttempt {
  id          String   @id @default(uuid()) @db.Uuid
  therapistId String   @db.Uuid
  createdAt   DateTime @default(now())

  therapist User @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([therapistId, createdAt])
}
